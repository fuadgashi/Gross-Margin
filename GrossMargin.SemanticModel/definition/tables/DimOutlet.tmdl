/// Outlets: the customers' points of sale, with the channel, region and city the Channel / Region slicer reads. Sales and trade terms carry an outlet; credit notes and service invoices do not.
table DimOutlet
	lineageTag: 9a1aa350-7cf9-4bfe-86f1-4ef980d64fa1

	/// Outlet code.
	column OutletId
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 72028f7c-d292-4baa-aebe-87e3e66a5e14
		summarizeBy: none
		sourceColumn: OutletId

		annotation SummarizationSetBy = Automatic

	/// Outlet name. Sorted by OutletSortOrder.
	column OutletName
		dataType: string
		isAvailableInMdx: false
		lineageTag: 5090823c-98cc-48e6-9c6e-5a709cccd2c8
		isDefaultLabel
		summarizeBy: none
		sourceColumn: OutletName
		sortByColumn: OutletSortOrder

		annotation SummarizationSetBy = Automatic

	/// Display order of OutletName, from the source: one position per outlet name.
	column OutletSortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e19a3637-002d-4e1a-9f28-8a119890c322
		summarizeBy: none
		sourceColumn: OutletSortOrder

		annotation SummarizationSetBy = Automatic

	/// The customer and the outlet on one line, for a table that lists outlets of several customers.
	column OutletLabel
		dataType: string
		isAvailableInMdx: false
		lineageTag: 449512b8-23e9-4cc3-838b-dea554d00441
		summarizeBy: none
		sourceColumn: OutletLabel

		annotation SummarizationSetBy = Automatic

	/// Customer that owns the outlet. Joins to DimPartner.
	column PartnerId
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 43bc22ae-feef-4074-83e3-6d6d12a825d7
		summarizeBy: none
		sourceColumn: PartnerId

		annotation SummarizationSetBy = Automatic

	/// Sales channel of the outlet.
	column Channel
		dataType: string
		isAvailableInMdx: false
		lineageTag: 690ae7f5-f16a-4491-bc91-1dedb336cf1a
		summarizeBy: none
		sourceColumn: Channel

		annotation SummarizationSetBy = Automatic

	/// Sales region of the outlet.
	column Region
		dataType: string
		isAvailableInMdx: false
		lineageTag: 009bffb5-3b0c-4976-ae92-c6143d90c05b
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	/// City of the outlet.
	column City
		dataType: string
		isAvailableInMdx: false
		lineageTag: 750b3733-cf7a-4e51-a819-4873c58c01ac
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = Automatic
	partition DimOutlet = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Outlets with their customer, channel, region and city.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    o.OutletId,
				                    o.OutletName,
				                    o.SortOrder AS OutletSortOrder,
				                    CONCAT(p.PartnerName, N' - ', o.OutletName) AS OutletLabel,
				                    o.PartnerId,
				                    o.Channel,
				                    o.Region,
				                    o.City
				                FROM ti.Outlet o
				                INNER JOIN ti.Partner p
				                    ON p.PartnerId = o.PartnerId
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"OutletId"}, true)
				in
				    Keyed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

