/// Organisational units: the warehouses and vans documents are booked in.
table DimOrgUnit
	lineageTag: 09637aef-ffa7-4d4b-99b6-489c6d35eea9

	/// Organisational unit code.
	column OrgUnitId
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: cb9f24be-9acc-417e-adfe-06940150019f
		summarizeBy: none
		sourceColumn: OrgUnitId

		annotation SummarizationSetBy = Automatic

	/// Organisational unit name. Sorted by OrgUnitSortOrder.
	column OrgUnitName
		dataType: string
		isAvailableInMdx: false
		lineageTag: cfec5f6a-22aa-4e64-8ab1-305655a7de8e
		isDefaultLabel
		summarizeBy: none
		sourceColumn: OrgUnitName
		sortByColumn: OrgUnitSortOrder

		annotation SummarizationSetBy = Automatic

	/// Display order of OrgUnitName, from the source: one position per unit name.
	column OrgUnitSortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f935183b-813a-49cf-b969-bf7399ef6ae5
		summarizeBy: none
		sourceColumn: OrgUnitSortOrder

		annotation SummarizationSetBy = Automatic
	partition DimOrgUnit = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Organisational units: warehouses and vans.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    o.OrgUnitId,
				                    o.OrgUnitName,
				                    o.SortOrder AS OrgUnitSortOrder
				                FROM ti.OrgUnit o
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"OrgUnitId"}, true)
				in
				    Keyed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

