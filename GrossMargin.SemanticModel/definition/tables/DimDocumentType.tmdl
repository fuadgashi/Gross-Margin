/// Document types, with the flags that say which documents are sales.
table DimDocumentType
	lineageTag: 56f62fee-55be-4671-948b-0b5d8b65b166

	/// Document type code.
	column DocumentTypeId
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 95add0bd-6660-4db0-86dd-602b95418c57
		summarizeBy: none
		sourceColumn: DocumentTypeId

		annotation SummarizationSetBy = Automatic

	/// Document type name.
	column DocumentTypeName
		dataType: string
		isAvailableInMdx: false
		lineageTag: 20359b0a-5706-4f5e-9e97-8cd03fe5cfa8
		isDefaultLabel
		summarizeBy: none
		sourceColumn: DocumentTypeName

		annotation SummarizationSetBy = Automatic

	/// TRUE for document types that move goods out to a customer, returns included. Every sales measure filters on it.
	column IsSalesOut
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: 95938f43-ed51-4888-8eb5-f1ff117c6f1b
		summarizeBy: none
		sourceColumn: IsSalesOut

		annotation SummarizationSetBy = Automatic

	partition DimDocumentType = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Document types, with the sales flag kept in the source.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    t.DocumentTypeId,
				                    t.DocumentTypeName,
				                    -- a document type the source adds arrives unflagged and counts in no total until it is flagged
				                    t.IsSalesOut
				                FROM ti.DocumentType t
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"DocumentTypeId"}, true),
				    Typed = Table.TransformColumnTypes(Keyed, {{"IsSalesOut", type logical}})
				in
				    Typed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

