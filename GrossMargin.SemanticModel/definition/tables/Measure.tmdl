	/// Extra discount given year-to-date. Value; a Lookup view of Extra Discount Actual Year for the marketing tooltip.
	measure 'Extra Discount | Tooltip' =
			
			[Extra Discount Actual Year]
		displayFolder: Lookup\Marketing
