	/// Theme colour name for [Marketing Price Effect]: good when it rises, neutral at 0, blank when it is blank. Generated by scripts/rag_colors.py from the RagColor annotation on [Marketing Price Effect]; edit the annotation, not this measure.
	measure 'Marketing Price Effect Color' = RagColor( [Marketing Price Effect], 0 )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: ef12f674-b122-4eeb-a2bf-373b8b07f752

		annotation PBI_FormatHint = {"isText":true}

	/// Theme colour name for the marketing verdict: good when price and volume both add sales, bad when both cost sales, neutral for a mixed verdict.
	measure 'Marketing Verdict Color' =
			VAR _first_effect = [Marketing Price Effect]
			VAR _second_effect = [Marketing Quantity Effect]
			-- same signs as the verdict text, a zero effect taking the other's sign, so colour
			-- and wording always agree: both up is good, both down is bad, a mixed verdict is neither
			VAR _first_sign = IF( _first_effect = 0, SIGN( _second_effect ), SIGN( _first_effect ) )
			VAR _second_sign = IF( _second_effect = 0, SIGN( _first_effect ), SIGN( _second_effect ) )
			RETURN
			    IF(
			        NOT ( ISBLANK( _first_effect ) || ISBLANK( _second_effect ) || ( _first_sign = 0 && _second_sign = 0 ) ),
			        RagColor( _first_sign + _second_sign, 0 )
			    )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: 247ef5cd-ac77-4c6f-bc46-7f4f2415b2dd

		annotation PBI_FormatHint = {"isText":true}

	/// The extra discount without VAT: quantity x (price after the regular discount - net price), with the VAT on the line taken out. The Budget Spent family's discount part, on the same basis as the other spend, which is all without VAT. Value.
	measure 'Extra Discount Without VAT' =
			CALCULATE(
			    SUMX(
			        FactSalesLine,
			        FactSalesLine[Quantity]
			            * ( FactSalesLine[GrossPrice] - FactSalesLine[NetPrice] )
			            * FactSalesLine[ExVatFactor]
			    ),
			    DimDocumentType[IsSalesOut] = TRUE
			)
		formatString: #,0
		displayFolder: Trade Marketing\Trade Spend
		lineageTag: d5801bd3-d504-48e0-a9e1-1ed59b51d270

	/// Service and rent invoices to suppliers, without VAT, booked to the supplier's brand (FactServiceInvoice): added to the marketing budget (Budget Accumulated). Value.
	measure 'Service Invoices' = SUM( FactServiceInvoice[Value] )
		formatString: #,0
		displayFolder: Trade Marketing\Trade Spend
		lineageTag: 32d0b6d5-3726-446c-9dcb-cfb71692282c

	/// Service invoices to suppliers ([Service Invoices]), this year to date: the date slicers' window within this year, cut at today (1 January to today when no slicer is set). Value.
	measure 'Service Invoices Actual Year' = YearToDay( [Service Invoices] )
		formatString: #,0
		displayFolder: Trade Marketing\Trade Spend
		lineageTag: 2a5b4537-483e-4aaf-835e-cdc85238951d

	/// Campaigns agreed with customers in the trade-terms register (fixed value): each amount as agreed, dated at the campaign's start. Without VAT. Value.
	measure Campaigns =
			CALCULATE(
			    SUM( FactTradeTerm[Spent] ),
			    FactTradeTerm[TermGroup] = "Campaign",
			    FactTradeTerm[IsPercentage] = FALSE
			)
		formatString: #,0
		displayFolder: Trade Marketing\Trade Spend
		lineageTag: 181b8831-be57-456b-85b7-c53343f3c841

	/// Promotions agreed with customers in the trade-terms register (fixed value): each amount as agreed, dated at its start. Without VAT. Value.
	measure Promotions =
			CALCULATE(
			    SUM( FactTradeTerm[Spent] ),
			    FactTradeTerm[TermGroup] = "Promotion",
			    FactTradeTerm[IsPercentage] = FALSE
			)
		formatString: #,0
		displayFolder: Trade Marketing\Trade Spend
		lineageTag: ebdf98e7-2d78-497b-bba0-504ed8a75421

	/// Seasonal fixed positions: the fixed-value positions (and marketing terms) that do not run a whole calendar year, value x units in each month they have run up to today, each month its own (FactTradeTermMonth). Without VAT. Value.
	measure 'Seasonal Fixed Positions' =
			CALCULATE(
			    SUM( FactTradeTermMonth[Spent] ),
			    FactTradeTermMonth[TermGroup] = "Position",
			    FactTradeTermMonth[IsPercentage] = FALSE,
			    FactTradeTermMonth[IsFullYear] = FALSE,
			    -- the months run up to today: the months still to come are a commitment, not spent
			    KEEPFILTERS( DimDate[Date] <= TODAY() )
			)
		formatString: #,0
		displayFolder: Trade Marketing\Trade Spend
		lineageTag: 2406e524-de9a-4ba3-a952-996dfc3f88aa

	/// The trade terms the business counts as trade spend: campaigns, promotions and seasonal fixed positions. Without VAT. Value.
	measure 'Trade Terms Spent' = [Campaigns] + [Promotions] + [Seasonal Fixed Positions]
		formatString: #,0
		displayFolder: Trade Marketing\Trade Spend
		lineageTag: f303e735-bff7-44dc-96b6-553cf4630ed0

	/// Trade terms spent ([Trade Terms Spent]), this year to date: the date slicers' window within this year, cut at today (1 January to today when no slicer is set). Value.
	measure 'Trade Terms Spent Actual Year' = YearToDay( [Trade Terms Spent] )
		formatString: #,0
		displayFolder: Trade Marketing\Trade Spend
		lineageTag: 7e8901f1-c4e3-40b8-8775-88c76be057e9

	/// 1 where the item in context has sales in the selected dates, blank otherwise. The hidden filter of the product and organisation slicers, so they list only items with data. A flag.
	measure 'Slicer Has Data' = IF( NOT ISBLANK( [Sales Net Price] ), 1 )
		formatString: 0
		isHidden
		displayFolder: Formatting\Slicer Filter
		lineageTag: cc1ad80f-431a-4165-99db-228df5042548

	partition Measure = m
		mode: import
		queryGroup: Model
		source =
				let
				    // Query group: Model
				    // Measure-table scaffold: an empty table that hosts measures only.
				    Source = #table({}, {})
				in
