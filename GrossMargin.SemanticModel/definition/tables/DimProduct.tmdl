/// The product catalogue: one row per product, with its brand.
table DimProduct
	lineageTag: 9b0d0406-44cb-45af-a826-e83055824c63

	/// Product code.
	column ProductId
		dataType: int64
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 638b56ef-af1b-412b-848d-5851ffec36f1
		summarizeBy: none
		sourceColumn: ProductId

		annotation SummarizationSetBy = Automatic

	/// Product name as it appears in the catalogue. Sorted by ProductSortOrder.
	column ProductName
		dataType: string
		isAvailableInMdx: false
		lineageTag: db93b85e-7747-4996-809d-f6afbcb56bba
		isDefaultLabel
		summarizeBy: none
		sourceColumn: ProductName
		sortByColumn: ProductSortOrder

		annotation SummarizationSetBy = Automatic

	/// Display order of ProductName, from the source: one position per product name.
	column ProductSortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b55b6b0e-1349-4b4f-bc0b-b1365518d6ba
		summarizeBy: none
		sourceColumn: ProductSortOrder

		annotation SummarizationSetBy = Automatic

	/// Brand of the product. Joins to DimBrand; blank for a product the brand list leaves out.
	column BrandId
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 13cd063e-d3b9-4cb8-b88c-0e0e0238764d
		summarizeBy: none
		sourceColumn: BrandId

		annotation SummarizationSetBy = Automatic

	partition DimProduct = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // The product catalogue with brand and display order.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    p.ProductId,
				                    p.ProductName,
				                    p.SortOrder AS ProductSortOrder,
				                    p.BrandId
				                FROM ti.Product p
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"ProductId"}, true)
				in
				    Keyed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

