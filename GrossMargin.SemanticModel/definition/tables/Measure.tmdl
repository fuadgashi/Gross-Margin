	/// Budget spent year-to-date: extra discounts, credit notes issued and marketing invoices. Value; a Lookup view of Budget Spent Actual Year for the marketing tooltip.
	measure 'Budget Spent | Tooltip' =
			
			[Budget Spent Actual Year]
		displayFolder: Lookup\Marketing
		lineageTag: 152d205c-3442-49bd-9f06-fbfe5ca4dd42

