/// Service and rent invoices the company sends its suppliers, booked to the supplier's brand: money suppliers give back to the trade budget. Window: 1 January of the prior year onwards.
table FactServiceInvoice
	lineageTag: 61a0cd3e-9eda-4171-8ecb-5d30286ac8d2

	/// Invoice date. Joins to DimDate.
	column Date
		dataType: dateTime
		formatString: dd/mm/yyyy
		isAvailableInMdx: false
		lineageTag: 0bc687d4-8ba3-4477-85ac-a01b3e32d0f3
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// Supplier invoiced. Joins to DimPartner.
	column PartnerId
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: c7beb000-2f4f-4376-8b0c-569663dd06de
		summarizeBy: none
		sourceColumn: PartnerId

		annotation SummarizationSetBy = Automatic

	/// Brand the supplier's invoices are booked to, from the source. Joins to DimBrand; blank for a supplier with no brand.
	column BrandId
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 952a9ce2-e32b-474c-998f-94836dda005d
		summarizeBy: none
		sourceColumn: BrandId

		annotation SummarizationSetBy = Automatic

	/// Invoice value without VAT.
	column Value
		dataType: double
		isHidden
		isAvailableInMdx: false
		lineageTag: 56b37756-48a7-4f70-981f-f8a5eb903485
		summarizeBy: none
		sourceColumn: Value

		annotation SummarizationSetBy = Automatic
	partition FactServiceInvoice = m
		mode: import
		queryGroup: Fact
		source = ```
				let
				    // Service and rent invoices to suppliers, booked to the supplier's brand.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    CAST(i.InvoiceDate AS DATE) AS [Date],
				                    i.PartnerId,
				                    -- the source books each supplier's invoices to one brand
				                    i.BrandId,
				                    CAST(i.ValueExVat AS FLOAT) AS Value
				                FROM ti.ServiceInvoice i
				                WHERE i.InvoiceDate >= DATEFROMPARTS(YEAR(GETDATE()) - 1, 1, 1)
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Typed = Table.TransformColumnTypes(Source, {{"Date", type date}})
				in
				    Typed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

