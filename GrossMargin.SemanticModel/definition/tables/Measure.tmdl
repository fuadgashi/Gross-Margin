		formatStringDefinition =
				VAR _unit = " ""of gross sales"""
				RETURN
				    "0.00%" & _unit

	/// Theme colour name for [Brand Distribution Effect]: good when it rises, neutral at 0, blank when it is blank. Generated by scripts/rag_colors.py from the RagColor annotation on [Brand Distribution Effect]; edit the annotation, not this measure.
	measure 'Brand Distribution Effect Color' = RagColor( [Brand Distribution Effect], 0 )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: 1b365186-4fd0-480d-953b-ac79a8c96e7b

		annotation PBI_FormatHint = {"isText":true}

	/// Theme colour name for [Brand Sales per Outlet Effect]: good when it rises, neutral at 0, blank when it is blank. Generated by scripts/rag_colors.py from the RagColor annotation on [Brand Sales per Outlet Effect]; edit the annotation, not this measure.
	measure 'Brand Sales per Outlet Effect Color' = RagColor( [Brand Sales per Outlet Effect], 0 )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: 6a4df210-41f4-42c0-92e6-5534670744fa

		annotation PBI_FormatHint = {"isText":true}

	/// Theme colour name for the Brand Verdict: good when both effects add sales, bad when both cost sales, neutral for a mixed verdict.
	measure 'Brand Verdict Color' =
			VAR _first_effect = [Brand Distribution Effect]
			VAR _second_effect = [Brand Sales per Outlet Effect]
			-- same signs as the verdict text, a zero effect taking the other's sign, so colour
			-- and wording always agree: both up is good, both down is bad, a mixed verdict is neither
			VAR _first_sign = IF( _first_effect = 0, SIGN( _second_effect ), SIGN( _first_effect ) )
			VAR _second_sign = IF( _second_effect = 0, SIGN( _first_effect ), SIGN( _second_effect ) )
			RETURN
			    IF(
			        NOT ( ISBLANK( _first_effect ) || ISBLANK( _second_effect ) || ( _first_sign = 0 && _second_sign = 0 ) ),
			        RagColor( _first_sign + _second_sign, 0 )
			    )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: 47cb9867-3556-409a-845f-435086b10684

		annotation PBI_FormatHint = {"isText":true}

	/// Theme colour name for [Budget Difference | Tooltip]: good when it rises, neutral at 0, blank when it is blank. Generated by scripts/rag_colors.py from the RagColor annotation on [Budget Difference | Tooltip]; edit the annotation, not this measure.
	measure 'Budget Difference Color | Tooltip' = RagColor( [Budget Difference | Tooltip], 0 )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: aedc1948-5b04-4258-9467-9efb1d350112

		annotation PBI_FormatHint = {"isText":true}

	/// Theme colour name for [Marketing Quantity Effect]: good when it rises, neutral at 0, blank when it is blank. Generated by scripts/rag_colors.py from the RagColor annotation on [Marketing Quantity Effect]; edit the annotation, not this measure.
	measure 'Marketing Quantity Effect Color' = RagColor( [Marketing Quantity Effect], 0 )
