/// Credit notes, split by brand: issued to customers (trade spend) and received from suppliers (budget given back). Window: 1 January of the prior year onwards.
table FactCreditNote
	lineageTag: f52a7d95-f422-49a3-96cb-bdfa48aa35e5

	/// Credit note date. Joins to DimDate.
	column Date
		dataType: dateTime
		formatString: dd/mm/yyyy
		isAvailableInMdx: false
		lineageTag: bd64a73a-94d4-4961-9f66-2d9c5262048c
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// Customer or supplier on the credit note. Joins to DimPartner.
	column PartnerId
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: e306e058-78f6-442b-bd53-b24a9205100b
		summarizeBy: none
		sourceColumn: PartnerId

		annotation SummarizationSetBy = Automatic

	/// Brand the credit note is booked on. Joins to DimBrand. A credit note carries no product and no outlet.
	column BrandId
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: bcb701eb-eba3-4f80-9eea-83d61f89b691
		summarizeBy: none
		sourceColumn: BrandId

		annotation SummarizationSetBy = Automatic

	/// Issued (to a customer) or Received (from a supplier), from the source.
	column Direction
		dataType: string
		isAvailableInMdx: false
		lineageTag: 698d73ea-41b0-433c-9368-b24f1a4f9dbf
		summarizeBy: none
		sourceColumn: Direction

		annotation SummarizationSetBy = Automatic

	/// Amount without VAT, positive.
	column Value
		dataType: double
		isHidden
		isAvailableInMdx: false
		lineageTag: d2b805ad-57fd-4ac2-b7a1-f8401394b0a9
		summarizeBy: none
		sourceColumn: Value

		annotation SummarizationSetBy = Automatic
	partition FactCreditNote = m
		mode: import
		queryGroup: Fact
		source = ```
				let
				    // Credit notes issued and received, split by brand.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    CAST(c.DocumentDate AS DATE) AS [Date],
				                    c.PartnerId,
				                    c.BrandId,
				                    -- the source names the direction: Issued or Received
				                    c.Direction,
				                    CAST(c.ValueExVat AS FLOAT) AS Value
				                FROM ti.CreditNote c
				                WHERE c.DocumentDate >= DATEFROMPARTS(YEAR(GETDATE()) - 1, 1, 1)
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Typed = Table.TransformColumnTypes(Source, {{"Date", type date}})
				in
				    Typed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

